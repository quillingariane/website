FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Copy config files
COPY prisma.config.ts tsconfig.json ./

# Copy the prisma folder
COPY prisma ./prisma

# Copy the files folder
COPY files/ ./files/

# Install dependencies
RUN npm install

# The CMD runs your custom start script
CMD ["sh", "./files/start.sh"]
